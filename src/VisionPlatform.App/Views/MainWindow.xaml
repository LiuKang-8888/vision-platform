<Window x:Class="VisionPlatform.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisionPlatform 运行台" Height="640" Width="960"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="健康：" VerticalAlignment="Center" FontSize="14"/>
      <TextBlock Text="{Binding HealthSummary}" VerticalAlignment="Center" FontWeight="Bold" Margin="4,0,16,0"/>
      <TextBlock Text="{Binding CommStatus}" VerticalAlignment="Center" Foreground="Gray"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,8,0" Background="#F5F5F5">
        <TextBlock Text="图像显示区（阶段 2 接入相机 / Halcon 控件）"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#666" TextWrapping="Wrap" TextAlignment="Center"/>
      </Border>

      <StackPanel Grid.Column="1">
        <TextBlock Text="识别结果" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding LastResultOk}" FontSize="36" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding LastResultText}" FontFamily="Consolas" FontSize="28" Margin="0,0,0,16"/>

        <CheckBox Content="已完成运行前审核（见 docs/watchdog.md）"
                  IsChecked="{Binding AuditConfirmed}" Margin="0,0,0,12"/>

        <Button Content="单次运行" Command="{Binding RunOnceCommand}" Height="40" FontSize="16"/>

        <TextBlock Text="{Binding LastError}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <TextBlock Text="已注册工具" Margin="0,24,0,4" FontWeight="SemiBold"/>
        <ListBox ItemsSource="{Binding RegisteredTools}" MaxHeight="160"/>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="Gray"
               Text="VisionPlatform 阶段 1 · 独立仓库 · 中文 UI"/>
  </Grid>
</Window>
