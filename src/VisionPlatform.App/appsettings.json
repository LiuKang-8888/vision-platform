{
  "Platform": {
    "SchemaVersion": 1,
    "Environment": "Development"
  },
  "Watchdog": {
    "HealthTickMs": 2000,
    "RunTimeoutMs": 5000,
    "RequirePreRunAudit": true
  },
  "Inspection": {
    "ToolChain": [ "Mock.GrabImage", "Mock.PassFail" ]
  },
  "Tcp": {
    "Server": { "Enabled": false, "Host": "0.0.0.0", "Port": 9500 },
    "Client": { "Enabled": false, "Host": "127.0.0.1", "Port": 9000 }
  },
  "Plc": {
    "DriverId": "Sim",
    "ModbusTcp": { "Host": "127.0.0.1", "Port": 502, "UnitId": 1 }
  },
  "Halcon": {
    "ProcedureRoot": "procedures"
  },
  "Inference": {
    "YoloModelPath": "",
    "Provider": "Cpu"
  },
  "Ocr": {
    "Backend": "Halcon"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  }
}
